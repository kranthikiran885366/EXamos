# ExamOS Kernel Hardening Configuration Fragment
# Enforces strict module signing, kexec disablement, kernel lockdown
# confidentiality mode, IOMMU strict DMA isolation, and Thunderbolt suppression.

# Strict Kernel Module Signing (prevents root from loading unsigned modules)
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y

# Disable kexec hot-swapping of the running kernel
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_KEXEC_JUMP is not set

# Linux Kernel Lockdown in Confidentiality Mode
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y

# CPU Control-Flow Integrity & Memory Mitigations
CONFIG_X86_KERNEL_IBT=y
CONFIG_X86_USER_SHADOW_STACK=y
CONFIG_CFI_CLANG=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y

# DMA / Thunderbolt / PCIe Attack Mitigation
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_INTEL_IOMMU=y
CONFIG_AMD_IOMMU=y
# CONFIG_THUNDERBOLT is not set
# CONFIG_FIREWIRE is not set
