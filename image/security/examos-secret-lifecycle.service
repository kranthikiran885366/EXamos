[Unit]
Description=ExamOS runtime secret revocation on shutdown or trust failure
After=examos-unseal.service
Before=examos-agent.service examos-proctor.service examos-server.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true
ExecStop=/usr/bin/python3 /usr/local/libexec/examos/revoke_runtime_secrets.py
TimeoutStopSec=10
ProtectSystem=strict
ReadWritePaths=-/run/examos/secrets
ProtectHome=true
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
LimitCORE=0

[Install]
WantedBy=multi-user.target
