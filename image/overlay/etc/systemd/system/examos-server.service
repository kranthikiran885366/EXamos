[Unit]
Description=ExamOS Examination Control Server (Admin Dashboard + Candidate Login)
Documentation=https://examos.example.edu/docs/server
After=network.target
Before=examos-kiosk.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/examos-server
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=EXAMOS_LEDGER_PATH=/var/log/examos/event_ledger.log
Environment=EXAMOS_SERVER_PORT=8000
EnvironmentFile=/etc/examos/proctor.env
Environment=EXAMOS_CANDIDATE_STORE=/etc/examos/candidates.conf

# Hardening
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/examos/admin.conf
ReadWritePaths=/var/log/examos /etc/examos/exam.conf

[Install]
WantedBy=multi-user.target
