[Unit]
Description=ExamOS Native C++ Proctoring and Anomaly Detection Engine
ConditionPathExists=/run/examos/secrets/proctor.env
StartLimitIntervalSec=300
StartLimitBurst=3
Requires=examos-unseal.service
After=network.target sound.target examos-kiosk.service examos-unseal.service
PartOf=examos-kiosk.service

[Service]
Type=simple
User=exam
Group=exam
SupplementaryGroups=audio
EnvironmentFile=/etc/examos/proctor.env
EnvironmentFile=/run/examos/secrets/proctor.env
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/local/bin/examos-proctor
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

# Sandboxing
ProtectSystem=strict
ReadWritePaths=/run/user/1000 /tmp
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
