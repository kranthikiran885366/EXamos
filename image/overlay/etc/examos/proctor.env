# Static proctoring service environment.
#
# Secrets are not stored in the image. They are unsealed at boot into
# /run/examos/secrets/proctor.env, which the service loads after this file.
# The NOT_PROVISIONED sentinels are intentional: startup is refused until the
# runtime secret file overrides every one of them.
EXAMOS_AGENT_API_TOKEN=NOT_PROVISIONED
EXAMOS_PROCTOR_API_TOKEN=NOT_PROVISIONED
EXAMOS_EVENT_SIGNING_KEY=NOT_PROVISIONED
EXAMOS_VARIANT_SECRET=NOT_PROVISIONED

# Optional in-process TLS. Leave these unset when a same-host ingress proxy
# terminates TLS and the server binds loopback only. See
# docs/security/TLS_PROVISIONING.md.
# EXAMOS_TLS_CERT=/etc/examos/tls/server.crt
# EXAMOS_TLS_KEY=/etc/examos/tls/server.key
