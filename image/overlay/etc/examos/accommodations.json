{
  "schema_version": 1,
  "wayland_compositor": "cage",
  "sandbox_preserved": true,
  "defaults": {
    "high_contrast": false,
    "screen_magnifier_scale": 1.0,
    "screen_reader_orca": false,
    "extra_time_multiplier": 1.0,
    "captions_enabled": true,
    "font_scale": 1.0
  },
  "allowed_accessibility_tools": [
    "orca",
    "speech-dispatcher"
  ],
  "blocked_escape_surfaces": [
    "terminal",
    "file-chooser-arbitrary-fs",
    "clipboard-external-sync",
    "vt-switch"
  ]
}
