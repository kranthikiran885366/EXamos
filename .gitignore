# ExamOS .gitignore
# =============================================================================
# Compiled object files and binaries
# =============================================================================
*.o
*.a
*.so
*.so.*

# Compiled native binaries (never commit; built from source)
agent/examos-agent
server/examos-server
server/examos-admin-ctl
server/attestation/examos-verifier
kiosk/launcher/examos-launcher
kiosk/launcher/examos-kiosk-launcher
proctoring/examos-proctor
tools/examos-operator-recovery
image/overlay/usr/local/bin/examos-agent
image/overlay/usr/local/bin/examos-kiosk-launcher
image/overlay/usr/local/bin/examos-proctor
image/overlay/usr/local/bin/examos-server

# =============================================================================
# Disk images and boot artifacts (large generated files)
# =============================================================================
*.raw
*.raw.raw
*.img
*.qcow2
*.vmdk
*.vmem
*.vmsd
*.vmx
*.vmxf
*.nvram
*.scoreboard
initrd.cpio.zst

# ISO images — do not track build artifacts
*.iso
# Kernel / boot artifacts captured inside evidence directories
*.efi
*.initrd
*.vmlinuz

# mkosi build outputs (all in image/)
image/examos.efi
image/examos.raw
image/examos.raw.efi
image/examos.initrd
image/examos.vmlinuz
image/examos-live.iso
image/examos.iso
image/examos.vmdk
image/examos.vmsd
image/examos.vmx
image/examos.vmxf
image/*.scoreboard
image/nvram
image/initrd.cpio.zst

# mkosi local configuration (contains machine-local build paths)
image/dev.conf
image/examos-build.conf

# =============================================================================
# VMware runtime files (VM state, logs, crash dumps — never source)
# =============================================================================
image/*.lck/
image/*.log
image/*.dmp
image/564d3942-cef2-90f5-139d-9227a67c4fac.vmem
image/564d3942-cef2-90f5-139d-9227a67c4fac.vmem.lck/

# =============================================================================
# Build directories and cache
# =============================================================================
build/
output/
cache/
artifacts/tmp/

# =============================================================================
# Secrets and credentials (NEVER commit)
# =============================================================================
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
secrets/
private/
keys/

# Trust key material — dev keys are generated by image/trust/generate-dev-keys.sh.
# Only the generator script and README are tracked. Generated key files are not.
image/trust/*.key
image/trust/*.crt
image/trust/*.pem
image/trust/PK.*
image/trust/KEK.*
image/trust/db.*
image/trust/pcr-policy.*

# TPM sealed secret bundles (written at deployment time, never at build time)
image/overlay/etc/examos/sealed/
*.sealed

# Runtime-generated secret files (tmpfs path — never on disk across reboots)
/run/examos/

# swtpm state directories
/tmp/examos-p3-tpm/

# =============================================================================
# Production gate outputs (regenerated; never treat local JSON as certification)
artifacts/production/*.json
artifacts/p0/reproducibility/
artifacts/p0/vmware/

# Stale CI/gate artifacts
# The following pattern excludes runtime-generated CSV/CSV-equivalent outputs.
# Gate results JSON with gate="PASS" must ONLY be uploaded as CI artifacts,
# never committed. Tombstone files (gate="INVALIDATED") may be committed.
# =============================================================================
artifacts/phase4/concurrency-results.csv
artifacts/phase4/detection-evaluation.csv

# =============================================================================
# Go build outputs
# =============================================================================
server/attestation/examos-verifier

# =============================================================================
# OS / Editor artifacts
# =============================================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
.wsl-io-probe.*
**/__pycache__/
*.pyc
