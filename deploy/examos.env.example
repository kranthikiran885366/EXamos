# ExamOS Server Environment Configuration
# Copy to .env or export these variables before running examos-server.

# ---------------------------------------------------------------
# Network / TLS
# ---------------------------------------------------------------
# Bind address for the HTTP server. Defaults to loopback (127.0.0.1).
# For remote console access set EXAMOS_TLS_TERMINATED=1 and place a TLS
# termination proxy in front.
EXAMOS_BIND_ADDR=127.0.0.1
EXAMOS_PORT=8000

# TLS. Set to 1 only when a TLS-terminating proxy is present.
EXAMOS_TLS_TERMINATED=0

# mTLS. When set to a PEM CA bundle path, client certificates are required.
# EXAMOS_MTLS_CA_CERT=/etc/examos/tls/ca.pem

# ---------------------------------------------------------------
# CORS — Console integration
# ---------------------------------------------------------------
# Comma-separated list of origins allowed to call the API from the browser.
# The React console runs on http://localhost:5173 in development and https://sppio-os.vercel.app in production.
EXAMOS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sppio-os.vercel.app

# ---------------------------------------------------------------
# Session / Auth tokens (shared secrets — set strong random values)
# ---------------------------------------------------------------
# HMAC key shared with the session journal and ledger.
EXAMOS_LEDGER_HMAC_KEY=changeme-32-byte-secret-key-hmac

# Admin session cookie secure flag (set 1 when served over HTTPS/TLS).
EXAMOS_ADMIN_COOKIE_SECURE=0

# Agent / proctor service bearer tokens (must match agent config).
EXAMOS_AGENT_API_TOKEN=changeme-agent-token
EXAMOS_PROCTOR_API_TOKEN=changeme-proctor-token

# ---------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------
# examos-admin-provision / examos-server connect via libpq.
# Example: postgresql://examos:changeme@localhost:5432/examos
EXAMOS_DATABASE_URL=postgresql://examos:examos@localhost:5432/examos
PGHOST=localhost
PGPORT=5432
PGDATABASE=examos
PGUSER=examos
PGPASSWORD=examos

# ---------------------------------------------------------------
# Deployment mode
# ---------------------------------------------------------------
# Set to "production" in production. Development mode allows loopback HTTP.
EXAMOS_TPM_MODE=development
EXAMOS_PRODUCTION_MODE=0

# ---------------------------------------------------------------
# Session journal (durable session WAL)
# ---------------------------------------------------------------
EXAMOS_SESSION_JOURNAL=/var/log/examos/session_journal.log

# ---------------------------------------------------------------
# Candidate store (PIN validation fallback paths)
# ---------------------------------------------------------------
# EXAMOS_CANDIDATE_STORE=/etc/examos/candidates.conf

# ---------------------------------------------------------------
# Kiosk / appliance
# ---------------------------------------------------------------
# EXAMOS_ALLOW_UNPROVISIONED_DEV=0
